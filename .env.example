GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Uma chave por pessoa para abrir a fila (16 caracteres ou mais, cada uma diferente). Sem as três, a fila e o painel ficam fechados.
CHAVE_TIAGO=
CHAVE_ALINE=
CHAVE_DENISE=
# Opcional: Redis por HTTP (Upstash) para a fila e o contador valerem entre instâncias. Sem estas duas, ficam na memória da instância.
KV_REST_API_URL=
KV_REST_API_TOKEN=
